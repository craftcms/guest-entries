{% import "_includes/forms" as forms %}

{% if settings.sections|length %}
    <h2>{{ 'Section Settings'|t('guest-entries') }}</h2>

    <p>{{ 'Choose which sections should allow guest submissions, and configure section-specific rules.'|t('guest-entries') }}</p>

    {% for index, sectionSettings in settings.sections %}
        <div class="pane">
            {% set section = Sections.getSectionByUid(sectionSettings.sectionUid) %}

            <h3>
                {{ chip(section, { hyperlink: true }) }}
            </h3>

            <div class="section-settings-group">
                {% namespace "sections[#{section.uid}]" %}
                    {{ hiddenInput('sectionUid', section.uid) }}
                    {% set prefix = "settings.sections.#{section.uid}" %}

                    <div class="section-settings-fields-essential">
                        {{ forms.lightswitchField({
                            id: 'allowGuestSubmissions',
                            label: 'Allow guest submissions?'|t('guest-entries'),
                            instructions: 'When enabled, anonymous users will be able to create entries in this section.'|t('guest-entries'),
                            name: 'allowGuestSubmissions',
                            on: old("#{prefix}.allowGuestSubmissions", sectionSettings.allowGuestSubmissions),
                            errors: errors.get("#{prefix}.allowGuestSubmissions"),
                            toggle: "section-settings-conditional-fields-#{section.uid}",
                        }) }}
                    </div>

                    <div class="section-settings-fields-conditional" id="section-settings-conditional-fields-{{ section.uid }}">
                        {{ forms.textField({
                            id: 'authorUid',
                            class: 'code',
                            name: 'authorUid',
                            label: 'Default Author Template'|t('guest-entries'),
                            instructions: 'A template that resolves to the UUID of an author that entries in this section will be attributed to.'|t('guest-entries'),
                            tip: 'Your template has access to all of this section’s properties, like `id`, `handle` and `uid`. The default behavior is equivalent to a query that finds the first user matching `.can("createEntries:#{uid}")`.'|t('guest-entries'),
                            value: old("#{prefix}.authorUid", sectionSettings.authorUid),
                            errors: errors.get("#{prefix}.authorUid"),
                        }) }}

                        {{ forms.lightswitchField({
                            id: 'enabledByDefault',
                            label: 'Enable entries by default?'|t('guest-entries'),
                            instructions: 'Should entries created by guests in this section be **enabled**, by default?'|t('guest-entries'),
                            name: 'enabledByDefault',
                            on: old("#{prefix}.enabledByDefault", sectionSettings.enabledByDefault),
                            errors: errors.get("#{prefix}.enabledByDefault"),
                        }) }}

                        {{ forms.lightswitchField({
                            id: 'runValidation',
                            label: 'Validate?'|t('guest-entries'),
                            instructions: 'Should validation rules be applied to the entry, when submitted by a guest? This should generally be **On** whenever entries are **Enabled by default**.'|t('guest-entries'),
                            name: 'runValidation',
                            on: old("#{prefix}.runValidation", sectionSettings.runValidation),
                            errors: errors.get("#{prefix}.runValidation"),
                        }) }}

                        {{ forms.textField({
                            label: 'Copy section UID'|t('guest-entries'),
                            instructions: 'Use this stable identifier in a hidden input when building forms that should create entries in this section.'|t('guest-entries'),
                            value: section.uid,
                            disabled: true,
                            monospace: true,
                        }) }}
                    </div>
                {% endnamespace %}
            </div>
        </div>
    {% endfor %}
{% else %}
    <div class="pane zilch">
        <p>{{ 'No sections available.'|t('guest-entries') }}</p>
    </div>
{% endif %}

<h2>{{ 'Global Settings'|t('guest-entries') }}</h2>

{{ 'These settings apply to **all** guest submissions.'|t('guest-entries')|md }}

{{ forms.textField({
    id: 'entryVariable',
    label: 'Entry Variable Name'|t('guest-entries'),
    instructions: 'The template variable name that entry submissions should be assigned to, if there is a validation error.'|t('guest-entries'),
    name: 'entryVariable',
    value: old('settings.entryVariable', settings.entryVariable),
    class: 'code',
    errors: errors.get('settings.entryVariable'),
    static: 'entryVariable' in overrides,
    readonly: 'entryVariable' in overrides,
    warning: 'entryVariable' in overrides ? 'This setting is being overridden by `{name}` in `{file}`.'|t('guest-entries', { name: 'entryVariable', file: 'config/craft/guest-entries.php' }),
}) }}
