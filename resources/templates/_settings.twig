{% import "_includes/forms" as forms %}

{% if settings.sections|length %}
    <h2>{{ 'Section Settings'|t('guest-entries') }}</h2>

    <p>{{ 'Choose which sections should allow guest submissions, and configure section-specific rules.'|t('guest-entries') }}</p>

    {% for index, sectionSettings in settings.sections %}
        <div class="pane">
            {% set section = craft.app.entries.getSectionByUid(sectionSettings.sectionUid) %}

            <h3>
                {{ chip(section, { hyperlink: true }) }}
            </h3>

            <div class="section-settings-group">
                {% namespace "sections[#{section.uid}]" %}
                    {{ hiddenInput('sectionUid', section.uid) }}

                    <div class="section-settings-fields-essential">
                        {{ forms.lightswitchField({
                            id: 'allowGuestSubmissions',
                            label: 'Allow guest submissions?'|t('guest-entries'),
                            instructions: 'When enabled, anonymous users will be able to create entries in this section.'|t('guest-entries'),
                            name: 'allowGuestSubmissions',
                            on: sectionSettings.allowGuestSubmissions ?? false,
                            errors: settings.errors().get("sections.#{index}.allowGuestSubmissions"),
                            toggle: "section-settings-conditional-fields-#{section.uid}"
                        }) }}
                    </div>

                    <div class="section-settings-fields-conditional" id="section-settings-conditional-fields-{{ section.uid }}">
                        {{ forms.selectField({
                            id: 'authorUid',
                            name: 'authorUid',
                            label: 'Default Author'|t('guest-entries'),
                            instructions: 'Who the guest entries should be attributed to by default.'|t('guest-entries'),
                            options: settings.getDefaultAuthorOptions(section.uid)|map(author => { label: author.fullName ? "#{author.fullName} (#{author.username})" : author.username, value: author.uid }),
                            value: sectionSettings.authorUid ?? false,
                            errors: settings.errors().get("sections.#{index}.authorId")
                        }) }}

                        {{ forms.lightswitchField({
                            id: 'enabledByDefault',
                            label: 'Enable entries by default?'|t('guest-entries'),
                            instructions: 'Should entries created by guests in this section be **enabled**, by default?'|t('guest-entries'),
                            name: 'enabledByDefault',
                            on: sectionSettings.enabledByDefault ?? false,
                            errors: settings.errors().get("sections.#{index}.enabledByDefault")
                        }) }}

                        {{ forms.lightswitchField({
                            id: 'runValidation',
                            label: 'Validate?'|t('guest-entries'),
                            instructions: 'Should validation rules be applied to the entry, when submitted by a guest?'|t('guest-entries'),
                            warning: 'This should generally be **On** whenever entries are **Enabled by default**.'|t('guest-entries'),
                            name: 'runValidation',
                            on: sectionSettings.runValidation ?? false,
                            errors: settings.errors().get("sections.#{index}.runValidation")
                        }) }}

                        {{ forms.textField({
                            label: 'Copy section UID'|t('guest-entries'),
                            instructions: 'Use this stable identifier in a hidden input when building forms that should create entries in this section.'|t('guest-entries'),
                            value: section.uid,
                            disabled: true,
                            monospace: true,
                        }) }}
                    </div>
                {% endnamespace %}
            </div>
        </div>
    {% endfor %}
{% else %}
    <div class="pane zilch">
        <p>{{ 'No sections available.'|t('guest-entries') }}</p>
    </div>
{% endif %}

<h2>{{ 'Global Settings'|t('guest-entries') }}</h2>

<p class="warning has-icon">
    <span class="icon" aria-hidden="true"></span>
    <span>{{ 'These settings apply to **all** guest submissions.'|t('guest-entries')|md(inline_only = true) }}</span>
</p>

{% set systemCsrf = craft.app.config.general.enableCsrfProtection %}

{{ forms.textField({
    id: 'entryVariable',
    label: 'Entry Variable Name'|t('guest-entries'),
    instructions: 'The template variable name that entry submissions should be assigned to, if there is a validation error.'|t('guest-entries'),
    name: 'entryVariable',
    value: settings.entryVariable,
    class: 'code'
}) }}
