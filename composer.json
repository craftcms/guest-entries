{
  "name": "craftcms/guest-entries",
  "description": "This plugin allows you to save guest entries from the front-end of your website.",
  "type": "craft-plugin",
  "keywords": [
    "cms",
    "craftcms",
    "guest",
    "entries",
    "laravel"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Pixel & Tonic",
      "homepage": "https://pixelandtonic.com/"
    }
  ],
  "support": {
    "email": "support@craftcms.com",
    "issues": "https://github.com/craftcms/guest-entries/issues?state=open",
    "source": "https://github.com/craftcms/guest-entries",
    "docs": "https://github.com/craftcms/guest-entries/blob/5.x/README.md",
    "rss": "https://github.com/craftcms/guest-entries/commits/5.x.atom"
  },
  "require": {
    "php": "^8.5",
    "craftcms/cms": "^6.0.0-beta.1"
  },
  "require-dev": {
    "larastan/larastan": "^3.13",
    "laravel/pint": "^1.22",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "CraftCms\\GuestEntries\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CraftCms\\GuestEntries\\Tests\\": "tests/",
      "CraftCms\\Cms\\Database\\Factories\\": "vendor/craftcms/cms/database/Factories/"
    }
  },
  "scripts": {
    "check-cs": "pint --test",
    "fix-cs": "pint",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "pest"
  },
  "extra": {
    "class": "CraftCms\\GuestEntries\\Plugin",
    "name": "Guest Entries",
    "handle": "guest-entries",
    "documentationUrl": "https://github.com/craftcms/guest-entries/blob/5.x/README.md"
  },
  "config": {
    "platform": {
      "php": "8.5"
    },
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
